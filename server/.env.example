# Kira Agent Platform - Environment Configuration Example

# Cấu hình Server
# QUAN TRỌNG: app Streamlit mặc định gọi http://localhost:3003/v1 (LOCAL_API_BASE trong app.py)
# → nên để PORT=3003 để hai bên khớp nhau.
PORT=3003
NODE_ENV=development

# Kết nối cơ sở dữ liệu MongoDB
MONGODB_URI=mongodb://localhost:27017/kiraapDB

# Cấu hình Chuỗi bảo mật JWT (thay đổi khi triển khai Production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Tài khoản Quản trị viên (Khởi tạo mặc định khi chạy seed)
ADMIN_EMAIL=admin@kiraap.com
ADMIN_PASSWORD=Admin@123
ADMIN_USERNAME=admin

# ─────────────────────────────────────────────
# Proxy /v1/* — Fallback credentials cho tài khoản mới / chưa xác thực
# ─────────────────────────────────────────────
# Cho phép request KHÔNG có kira_sk_* / JWT hợp lệ vẫn gọi được /v1/*
# và tự dùng API Key mặc định của hệ thống (thay vì trả 401 / drop connection).
# Đặt false khi cần xác thực nghiêm ngặt (production).
PROXY_ALLOW_FALLBACK=true

# API Key dự phòng cho hệ thống khi chưa cấu hình ApiKey trong DB
# (fallback trong apiKeyManager — dùng cho tài khoản mới / request chưa xác thực)
GEMINI_API_KEY=
GEMINI_PROJECT_ID=

# Số dư mặc định khi tài khoản mới đăng ký (Sign up / Register)
DEFAULT_USER_CREDITS=0
